func main
	C_LINESIZE = 80
	? copy("=",C_LINESIZE)
	? "WinUTF8Path Package"
	? copy("=",C_LINESIZE)
	? "UTF-8 file paths on MS-Windows (Cyrillic, Arabic, Chinese, ...) for the Ring programming language"
	? "Use w_dir(), w_rename(), w_remove(), w_getfilesize(), ... (the Ring function names with the w_ prefix)"
	? "See the folder : ring/extensions/winutf8path"
	? "See the folder : ring/samples/UsingWinUTF8Path"
	? copy("=",C_LINESIZE)
